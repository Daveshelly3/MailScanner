# Anthropic API key — get one at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# SQLite database path (no install needed)
DATABASE_URL=file:./mailscanner.db

# Optional: override the Outlook MCP server URL
# Leave blank when running inside a Claude Code session (auto-detected)
# MCP_SERVER_URL=

# Optional: override the Claude model
# AI_MODEL=claude-sonnet-4-20250514

PORT=3001
FRONTEND_URL=http://localhost:3001
NODE_ENV=development
