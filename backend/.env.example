# Anthropic API key — get one at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# ============================================================
# Email source — pick ONE of the three options below
# ============================================================

# OPTION 1 (recommended): IMAP — works with personal and work Outlook
# Generate an App Password at https://account.microsoft.com/security
# (Advanced security options > App passwords)
IMAP_USER=
IMAP_PASSWORD=
# Defaults work for both personal and work Outlook accounts
IMAP_HOST=outlook.office365.com
IMAP_PORT=993

# OPTION 2: Azure OAuth — requires app registration at portal.azure.com
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
# AZURE_TENANT_ID=common

# OPTION 3: MCP server (Claude Code session — leave blank for standalone use)
# MCP_SERVER_URL=

# ============================================================
# App settings
# ============================================================
DATABASE_URL=file:./mailscanner.db
SESSION_SECRET=change-me-to-a-long-random-string

# Optional: override the Claude model
# AI_MODEL=claude-sonnet-4-20250514

PORT=3001
FRONTEND_URL=http://localhost:3001
NODE_ENV=development
