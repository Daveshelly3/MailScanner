# Anthropic API key — get one at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Microsoft Azure App Registration (recommended for standalone use)
# Create one at https://portal.azure.com — see README for step-by-step
# Required scopes (delegated): Mail.Read, User.Read
# Redirect URI: http://localhost:3001/auth/callback
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=common

# SQLite database path (no install needed)
DATABASE_URL=file:./mailscanner.db

# Session secret (any long random string)
SESSION_SECRET=change-me-to-a-long-random-string

# Optional: override the Outlook MCP server URL
# Leave blank to use Azure OAuth above (recommended for Windows / standalone)
# When set, OAuth is bypassed and MCP is used instead
# MCP_SERVER_URL=

# Optional: override the Claude model
# AI_MODEL=claude-sonnet-4-20250514

PORT=3001
FRONTEND_URL=http://localhost:3001
NODE_ENV=development
