generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model ScanResult {
  id           String   @id @default(uuid())
  scannedAt    DateTime @default(now())
  timeWindow   String
  folder       String
  emailCount   Int
  flaggedCount Int
  urgentCount  Int
  results      String   // JSON stored as text in SQLite
}
